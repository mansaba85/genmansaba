# PORT CONFIGURATION (Portainer & Docker)
# PORT: Port internal di dalam container (default: 3000)
PORT=3000
# HOST_PORT: Port eksternal di Host Portainer / Proxmox (bisa diganti misal 3080, 8080, dll agar tidak bentrok)
HOST_PORT=3000

# =====================================================================
# 1. PRIMARY AI: 9ROUTER AI GATEWAY (OpenAI-Compatible)
# =====================================================================
# URL Gateway 9router (melewati Cloudflare Tunnel)
OPENAI_BASE_URL="https://9router.manubanyuputih.id/v1"

# PENTING: Kunci API harus merupakan "Remote API Key" yang sah dan diizinkan
# oleh 9router untuk akses remote. Kunci lokal yang ditolak akan mengembalikan
# HTTP 401 "API key required for remote API access".
OPENAI_API_KEY="sk-YOUR_REMOTE_9ROUTER_KEY_HERE"

# Model AI prioritas (misal: "komoboku" atau "gemini/gemini-3.6-flash").
# Jika kosong, server otomatis memilih model terbaik yang tersedia di gateway.
OPENAI_MODEL="komoboku"

# =====================================================================
# 2. BACKUP AI: GOOGLE GEMINI API (Cadangan Otomatis)
# =====================================================================
# Jika 9router mengalami kendala (HTTP 401, timeout, atau kuota habis),
# sistem otomatis beralih ke Google Gemini resmi agar guru tetap mendapatkan
# soal otentik berbasis Capaian Pembelajaran (bukan bank template darurat).
GEMINI_API_KEY="AIzaSy..."

# APP_URL: The URL where this applet is hosted (opsional).
APP_URL="http://localhost:3000"



